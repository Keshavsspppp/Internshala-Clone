# MongoDB Connection URL
DATABASE_URL=
# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment (use production on Render)
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# Default admin account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@internarea.com
ADMIN_PHONE=9999999999
# REQUIRED (Server will throw on startup if missing):
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Razorpay API Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
# Recommended on Render: upload the service account JSON as a secret file.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# Alternatives to GOOGLE_APPLICATION_CREDENTIALS (choose only one method):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT Configuration for Admin Panel
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
# Separate signing key for verified student browser sessions
USER_SESSION_JWT_SECRET=your_user_session_jwt_secret_here
# Recommended separate secret for 24-hour French-language verification tokens
LANGUAGE_JWT_SECRET=your_language_jwt_secret_here

# SMTP Email Configuration (Nodemailer)
# For Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Passwords should be a 16-character Gmail App Password (not your account password)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_smtp_password_or_app_password_here
SMTP_FROM=your_smtp_sender_email_here

# Alternative email provider (takes precedence over SMTP)
RESEND_API_KEY=
RESEND_FROM=InternArea <no-reply@your-verified-domain.example>

# Cloudinary media uploads for Public Space
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional additional HTTPS hosts allowed for resume profile images
ALLOWED_RESUME_IMAGE_HOSTS=
